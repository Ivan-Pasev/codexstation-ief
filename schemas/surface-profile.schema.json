{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexstation.g-i-l-c.com/ief/schemas/surface-profile.schema.json",
  "title": "CS-IEF SurfaceProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","surface_id","surface_version","mandatory_invariants","projection","profile_digest"],
  "properties": {
    "schema_version": {"const": "CS-IEF-08"},
    "surface_id": {"enum": ["chatgpt","gemini","gemini-notebook","portable"]},
    "surface_version": {"type":"string","minLength":1},
    "mandatory_invariants": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "projection": {
      "type":"object",
      "additionalProperties":false,
      "properties": {
        "source_first":{"type":"boolean"},
        "tool_routing":{"type":"boolean"},
        "portable_filesystem":{"type":"boolean"},
        "context_budget":{"type":["integer","null"],"minimum":1},
        "chunking":{"type":"string"},
        "bootstrap":{"type":"string"}
      }
    },
    "profile_digest":{"type":"string","minLength":1}
  }
}