{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexstation.g-i-l-c.com/ief/schemas/distribution-bundle.schema.json",
  "title": "CS-IEF DistributionBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","distribution_id","target_surface","omega_version","compiler_version","source_graph_digest","capability_manifest_digest","surface_profile_digest","artifacts","omissions","unsupported_capabilities","constitutional_equivalence","bundle_digest"],
  "properties": {
    "schema_version":{"const":"CS-IEF-08"},
    "distribution_id":{"type":"string","minLength":1},
    "target_surface":{"enum":["chatgpt","gemini","gemini-notebook","portable"]},
    "omega_version":{"type":"string","minLength":1},
    "compiler_version":{"type":"string","minLength":1},
    "source_graph_digest":{"type":"string","minLength":1},
    "capability_manifest_digest":{"type":"string","minLength":1},
    "surface_profile_digest":{"type":"string","minLength":1},
    "artifacts":{"type":"array","items":{"type":"object","required":["path","digest"],"properties":{"path":{"type":"string"},"type":{"type":"string"},"digest":{"type":"string"}},"additionalProperties":false}},
    "omissions":{"type":"array","items":{"type":"string"}},
    "unsupported_capabilities":{"type":"array","items":{"type":"string"}},
    "capability_degradations":{"type":"array","items":{"type":"string"}},
    "constitutional_equivalence":{"enum":["PASS","FAIL"]},
    "stale":{"type":"boolean"},
    "bundle_digest":{"type":"string","minLength":1}
  }
}